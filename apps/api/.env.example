PORT=4000
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/course-enrollment-system
# Replace with a private random value of at least 32 characters before deployment.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Optional explicit demo seed configuration. Use unique credentials for local development.
# The seed refuses to run unless SEED_CONFIRM=YES and refuses NODE_ENV=production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
